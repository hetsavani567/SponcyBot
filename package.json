{
  "name": "sponcybot",
  "version": "1.0.0",
  "description": "SponcyBot - AI-Powered Sponsorship Outreach & CRM Platform",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "cd backend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build": "cd frontend && npm run build && cd .. && node -e \"const fs=require('fs'); fs.cpSync('frontend/dist', 'backend/public', {recursive: true});\"",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "seed:outreach": "cd backend && npm run seed:outreach",
    "db:clear": "cd backend && npm run db:clear",
    "test": "cd backend && node src/scripts/testOutreachLogic.js"
  },
  "keywords": [
    "sponsorship",
    "hackathon",
    "email-outreach",
    "gemini-ai",
    "crm",
    "react",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@tavily/core": "^0.7.13",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "googleapis": "^186.0.0",
    "mongoose": "^9.11.1"
  }
}
