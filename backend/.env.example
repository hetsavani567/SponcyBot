# ─── Server Configuration ───────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ─── MongoDB Atlas Database ─────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sponcybot?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/sponcybot?retryWrites=true&w=majority

# ─── AI Intelligence (Google Gemini & Tavily Search) ────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
TAVILY_API_KEY=your_tavily_api_key_here

# ─── Gmail OAuth 2.0 Configuration ──────────────────────────────────────────
# Authorized redirect URI in Google Cloud Console must match:
# For Local Development: http://localhost:5000/gmail/oauth/callback
# For Deployed App:      https://<your-deployed-domain>/gmail/oauth/callback
GMAIL_CLIENT_ID=your_google_cloud_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_cloud_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:5000/gmail/oauth/callback
GMAIL_SENDER_EMAIL=sponsorships@hackathon.club